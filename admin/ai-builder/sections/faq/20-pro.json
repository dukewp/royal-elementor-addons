ition_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"449c77b","repeater_bg_image":{"url":"https:\/\/demosites.royal-elementor-addons.com\/fashion-v1\/wp-content\/plugins\/elementor\/assets\/images\/placeholder.png","id":""}},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"04abdc7","repeater_bg_image":{"url":"https:\/\/demosites.royal-elementor-addons.com\/fashion-v1\/wp-content\/plugins\/elementor\/assets\/images\/placeholder.png","id":""}}],"margin":{"unit":"px","top":"0","right":0,"bottom":"100","left":0,"isLinked":false},"padding_tablet":{"unit":"px","top":"0","right":"20","bottom":"0","left":"20","isLinked":false},"bg_image":{"url":"https:\/\/demosites.royal-elementor-addons.com\/fashion-v1\/wp-content\/plugins\/elementor\/assets\/images\/placeholder.png","id":""},"custom_breakpoints":"default","background_background":"classic","background_color":"#272727","padding":{"unit":"px","top":"30","right":"30","bottom":"30","left":"30","isLinked":true}},"elements":[{"id":"26ad862f","settings":{"_column_size":100,"_inline_size":null,"_inline_size_tablet":100},"elements":[{"id":"631a600b","settings":{"structure":"20","background_background":"classic","background_color":"#2D2D2D","hover_parallax":[{"layer_position_vr":{"unit":"%","size":30},"layer_position_hr":{"unit":"%","size":40},"_id":"0c6187f"},{"layer_position_vr":{"unit":"%","size":60},"layer_position_hr":{"unit":"%","size":20},"_id":"80dcb5c"}],"border_radius":{"unit":"px","top":"20","right":"20","bottom":"20","left":"20","isLinked":true},"padding":{"unit":"px","top":"40","right":"40","bottom":"40","left":"40","isLinked":true},"padding_mobile":{"unit":"px","top":"10","right":"10","bottom":"10","left":"10","isLinked":true}},"elements":[{"id":"34e5970b","settings":{"_column_size":50,"_inline_size":null},"elements":[{"id":"6eb74d6b","settings":{"tabs":[{"tab_title":"How do I track my order?","tab_content":"<p>Once you have completed your order, you\u2019ll receive a confirmation email with your order details. Our team will then be working extremely quickly to get this order picked and packed and sent out to you.<\/p><p>Once this has been dispatched, you\u2019ll receive an email notifying you of this (within 24 hours) with a 'VIEW AND TRACK YOUR ORDER' button included.<\/p>","_id":"6aada25"},{"tab_title":"How long does delivery take?","tab_content":"<p class=\"wysiwyg-text-align-left\">You can find a list of delivery timescales and prices per country\u00a0here.<\/p><p class=\"wysiwyg-text-align-left\">Additionally, once you reach checkout and enter your delivery address, the page will refresh and available shipping options will appear.<\/p><p class=\"wysiwyg-text-align-left\">Once you click your preferred option, you'll also see an\u00a0<strong>estimated<\/strong>\u00a0delivery date at the bottom of the page. Please note this date is an estimate and we can only guarantee Next Day Delivery.<\/p><p class=\"wysiwyg-text-align-left\">Need help? Please get in touch by simply clicking the \u00a0icon which can be located at the bottom left corner of the page. Make sure to have your details at the ready!<\/p><p class=\"wysiwyg-text-align-left\">Polly the bot will be more than happy to assist you with your order.<\/p>","_id":"0d8a2a6"},{"tab_title":"What is your returns policy?","tab_content":"<p class=\"wysiwyg-text-align-justify\">You are more than welcome to return your item unless the product description states it is non returnable (this applies to face masks, thongs, socks and some lingerie - please refer to \"Product Details\" for more information).<\/p><p class=\"wysiwyg-text-align-justify\">Please do your best to try on, handle and repackage the items with care. Items must be returned in their original condition - unworn, undamaged, free of makeup, pet hairs, deodorant and perfume and have all original tags.<\/p>","_id":"f73963b"}],"selected_icon":{"value":"fas fa-caret-down","library":"fa-solid"},"selected_active_icon":{"value":"fas fa-caret-up","library":"fa-solid"},"border_width":{"unit":"px","size":0,"sizes":[]},"title_color":"#FFFFFF","tab_active_color":"#FF4D4D","title_typography_typography":"custom","title_typography_font_family":"Archivo","title_typography_font_size":{"unit":"px","size":18,"sizes":[]},"title_typography_font_weight":"400","icon_align":"right","icon_color":"#FF4D4D","icon_active_color":"#FF4D4D","content_color":"#CECECE","content_typography_typography":"custom","content_typography_font_family":"Raleway","content_typography_font_size":{"unit":"px","size":14,"sizes":[]},"content_typography_font_weight":"500"},"elements":[],"isInner":false,"widgetType":"accordion","elType":"widget"}],"isInner":true,"elType":"column"},{"id":"6be383ff","settings":{"_column_size":50,"_inline_size":null},"elements":[{"id":"54071f76","settings":{"tabs":[{"tab_title":"Can I return separate orders in one parcel?","tab_content":"<p>If you reside in the UK and your order is over \u00a340.00 you will qualify for free shipping!\u00a0<\/p><p>We also offer a Premium Delivery Subscription which costs \u00a39.99 per year for Unlimited Next Day Delivery for UK customers<\/p>","_id":"f73963b"},{"tab_title":"Can I check the progress of my return?","tab_content":"<p>Received the above error message? This will be because the information doesn't match up to your order.<\/p><p>Here are some top tips to requesting your return:<\/p><ul><li>Your order number \/ ID needs to be in this format:\u00a0<strong>OP<\/strong>000000<strong>UK<\/strong>\u00a0or\u00a0<strong>OP<\/strong>000000<strong>US -\u00a0<\/strong>we recommend referring to your order confirmation email or logging into your account to find this.\u00a0<\/li><li>Use\u00a0<strong>either<\/strong>\u00a0your email, postcode or phone number. Don't include them all.<\/li><\/ul><p><em>If you haven't received a confirmation email, there may be a spelling mistake or you used a different one instead!<\/em><\/p>","_id":"6aada25"},{"tab_title":"How do I return my parcel?","tab_content":"<p class=\"wysiwyg-text-align-justify\">You are more than welcome to return your item unless the product description states it is non returnable (this applies to face masks, thongs, socks and some lingerie - please refer to \"Product Details\" for more information).<\/p><p class=\"wysiwyg-text-align-justify\">Please do your best to try on, handle and repackage the items with care. Items must be returned in their original condition - unworn, undamaged, free of makeup, pet hairs, deodorant and perfume and have all original tags.<\/p>","_id":"0d8a2a6"}],"selected_icon":{"value":"fas fa-caret-down","library":"fa-solid"},"selected_active_icon":{"value":"fas fa-caret-up","library":"fa-solid"},"border_width":{"unit":"px","size":0,"sizes":[]},"title_color":"#FFFFFF","tab_active_color":"#FF4D4D","title_typography_typography":"custom","title_typography_font_family":"Archivo","title_typography_font_size":{"unit":"px","size":18,"sizes":[]},"title_typography_font_weight":"400","icon_align":"right","icon_color":"#FF4D4D","icon_active_color":"#FF4D4D","content_color":"#CECECE","content_typography_typography":"custom","content_typography_font_family":"Raleway","content_typography_font_size":{"unit":"px","size":14,"sizes":[]},"content_typography_font_weight":"500"},"elements":[],"isInner":false,"widgetType":"accordion","elType":"widget"}],"isInner":true,"elType":"column"}],"isInner":true,"elType":"section"}],"isInner":false,"elType":"column"}],"isInner":false,"elType":"section"}],"page_settings":{"background_background":"classic","background_color":"#272727"},"version":"0.4","title":"faq-DELETE","type":"page"}